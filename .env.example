# ==============================================================================
# VTP FLEET TRACKING ENVIRONMENT CONFIGURATION
# Copy this file to .env and provide real credentials when available.
# NEVER commit .env to version control or expose credentials.
# ==============================================================================

# Server Network Configuration (STRICT CORPORATE LAN SECURITY POLICY)
# Always bind to 127.0.0.1 for local dev or designated WiFi interface
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Viettel VTracking GPS Provider (Account 1)
VTRACKING_ENABLED=true
VTRACKING_BASE_URL=https://vtracking2.viettel.vn
VTRACKING_USERNAME=viettelpost_username_placeholder
VTRACKING_PASSWORD=viettelpost_password_placeholder
VTRACKING_ORG_ID=
VTRACKING_TIMEOUT_SECONDS=15

# Viettel VTracking GPS Provider (Account 2 - if applicable)
VTRACKING_ACC2_ENABLED=false
VTRACKING_ACC2_BASE_URL=https://vtracking2.viettel.vn
VTRACKING_ACC2_USERNAME=
VTRACKING_ACC2_PASSWORD=

# Adsun GPS Provider (Account 1)
ADSUN_ENABLED=true
ADSUN_AUTH_URL=https://auth.adsun.vn/Auth/LoginV4
ADSUN_API_URL=https://dinhvi.adsun.vn
ADSUN_USERNAME=adsun_username_placeholder
ADSUN_PASSWORD=adsun_password_placeholder
ADSUN_TIMEOUT_SECONDS=15

# Excel Data Sources
EXCEL_DANH_SACH_XE_PATH=/home/vtp-dng-hoangtv/Workspace/Download/Danh_sach_xe_10-10-2026.xlsx
EXCEL_TON_DOI_VAN_CHUYEN_PATH=/home/vtp-dng-hoangtv/Workspace/Download/Tồn đội vận chuyển DNG.xlsx

# Cache and Sync Settings
GPS_CACHE_TTL_SECONDS=60
GPS_STALE_THRESHOLD_SECONDS=1800
ENABLE_DEMO_MOCK_FALLBACK=true
